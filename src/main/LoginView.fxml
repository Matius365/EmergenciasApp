<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="20.0"
      prefWidth="400" prefHeight="300"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LoginController">

    <Label text="INICIAR SESIÓN" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <ChoiceBox fx:id="usuarioChoiceBox" prefWidth="250"/>

    <TextField fx:id="nombreField" promptText="Nombre" prefWidth="250"/>
    <TextField fx:id="telefonoField" promptText="Teléfono" prefWidth="250"/>

    <Button text="Entrar" onAction="#login" prefWidth="200"/>
    <Button text="Salir" onAction="#salirApp" prefWidth="200"/>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainController"
            style="-fx-background-color: #ecf0f1;">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_RIGHT"
              spacing="20"
              styleClass="top-bar">

            <Label fx:id="usuarioLabel"
                   text="Usuario"
                   styleClass="top-user-label"/>

            <Button text="Cerrar Sesión"
                    onAction="#logoutUsuario"
                    styleClass="danger-button"/>
        </HBox>
    </top>

    <!-- MENÚ LATERAL -->
    <left>
        <VBox spacing="15"
              prefWidth="260"
              alignment="TOP_CENTER"
              styleClass="side-menu">

            <Label text="MENÚ"
                   styleClass="menu-title"/>

            <Button text="🚨 Declarar Emergencia"
                    onAction="#declararEmergencia"
                    prefWidth="220"
                    prefHeight="45"/>

            <Button text="🏥 Centros de Salud"
                    onAction="#mostrarCentros"
                    prefWidth="220"
                    prefHeight="45"/>

            <Button text="📜 Ver Histórico"
                    onAction="#verHistorico"
                    prefWidth="220"
                    prefHeight="45"/>

            <Button text="📞 Agenda Telefónica"
                    onAction="#accesoTelefonos"
                    prefWidth="220"
                    prefHeight="45"/>

            <Button text="➕ Añadir Contacto"
                    onAction="#mostrarFormularioContacto"
                    prefWidth="220"
                    prefHeight="45"/>
        </VBox>
    </left>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-padding: 25;">

            <!-- ÁREA TEXTO -->
            <TextArea fx:id="areaTexto"
                      prefHeight="220"
                      prefWidth="700"
                      editable="false"
                      wrapText="true"/>

            <!-- FORM CONTACTOS -->
            <VBox fx:id="contactoForm"
                  visible="false"
                  managed="false"
                  spacing="10"
                  maxWidth="450"
                  styleClass="card">

                <Label text="➕ Añadir Contacto"
                       styleClass="section-title"/>

                <TextField fx:id="nombreField"
                           promptText="Nombre"/>

                <TextField fx:id="apellidoField"
                           promptText="Apellido"/>

                <TextField fx:id="telefonoField"
                           promptText="Teléfono"/>

                <Button text="Guardar Contacto"
                        onAction="#anadirContacto"
                        prefWidth="200"/>
            </VBox>

            <!-- TABLA -->
            <VBox fx:id="tablaContainer"
                  visible="false"
                  managed="false"
                  spacing="15"
                  styleClass="card">

                <Label text="📞 Lista de Contactos"
                       styleClass="section-title"/>

                <TableView fx:id="tablaPersonas"
                           prefHeight="320"
                           prefWidth="700">

                    <columns>
                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="80"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="180"/>

                        <TableColumn fx:id="colApellido"
                                     text="Apellido"
                                     prefWidth="180"/>

                        <TableColumn fx:id="colTelefono"
                                     text="Teléfono"
                                     prefWidth="220"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER"
                      spacing="15">

                    <Button text="🗑 Borrar"
                            onAction="#borrarSeleccionado"
                            prefWidth="150"
                            styleClass="danger-button"/>

                    <Button text="✏ Editar"
                            onAction="#editarSeleccionado"
                            prefWidth="150"
                            styleClass="warning-button"/>
                </HBox>

            </VBox>

            <!-- FORM EMERGENCIA -->
            <VBox fx:id="emergenciaForm"
                  visible="false"
                  managed="false"
                  spacing="10"
                  maxWidth="450"
                  styleClass="card">

                <Label text="🚨 Declarar Emergencia"
                       styleClass="section-title"/>

                <TextField fx:id="ubicacionField"
                           promptText="Ubicación"/>

                <TextField fx:id="municipioField"
                           promptText="Municipio"/>

                <TextField fx:id="usuarioField"
                           promptText="Datos Usuario"/>

                <TextField fx:id="tipoField"
                           promptText="Tipo de Emergencia"/>

                <Label text="Gravedad"/>

                <ChoiceBox fx:id="gravedadChoiceBox">

                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="LEVE"/>
                            <String fx:value="MEDIA"/>
                            <String fx:value="ALTA"/>
                        </FXCollections>
                    </items>

                </ChoiceBox>

                <Button text="Enviar Emergencia"
                        onAction="#enviarEmergencia"
                        prefWidth="220"
                        styleClass="danger-button"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>



